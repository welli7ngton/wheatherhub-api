WEATHERHUB_APP_NAME="WeatherHub API"
WEATHERHUB_DEBUG=false
WEATHERHUB_WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com
# Positive seconds per HTTP operation; these are not a total request deadline.
WEATHERHUB_WEATHER_PROVIDER_CONNECT_TIMEOUT=5
WEATHERHUB_WEATHER_PROVIDER_READ_TIMEOUT=10
WEATHERHUB_WEATHER_PROVIDER_WRITE_TIMEOUT=5
WEATHERHUB_WEATHER_PROVIDER_POOL_TIMEOUT=5
